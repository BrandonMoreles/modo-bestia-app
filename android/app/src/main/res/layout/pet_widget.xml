<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/pet_widget_bg">

    <ImageView
        android:id="@+id/pet_img"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher_foreground"
        android:contentDescription="Mascota" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pet_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bestia"
            android:textColor="#F2C230"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pet_msg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="4"
            android:ellipsize="end"
            android:text="Abre Modo Bestia para despertarme."
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/pet_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="#93A2AD"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
